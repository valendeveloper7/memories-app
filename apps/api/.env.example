# Servidor
NODE_ENV=development
PORT=4000

# Origen permitido del frontend (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Base de datos
# Con el docker-compose.yml incluido (usuario/clave del compose):
MONGODB_URI=mongodb://nosotros_app:nosotros_pass@127.0.0.1:27017/nosotros?authSource=admin
# Sin auth (mongod local suelto): mongodb://127.0.0.1:27017/nosotros
# MongoDB Atlas: mongodb+srv://usuario:clave@cluster.mongodb.net/nosotros

# JWT
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-distinto
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cloudinary (se usará a partir del módulo de uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
