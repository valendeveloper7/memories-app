# Servidor
NODE_ENV=development
PORT=4000

# Origen permitido del frontend (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Base de datos
MONGODB_URI=mongodb://127.0.0.1:27017/nosotros

# JWT
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-distinto
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cloudinary (se usará a partir del módulo de uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
